{
  "requires": {
    "db": {
      "kind": "sqlite",
      "credentials": {
        "database": ":memory:"
      }
    }
  },
  "[production]": {
    "requires": {
      "db": {
        "kind": "postgres"
      },
      "auth": "dummy"
    }
  },
  "odata": {
    "version": "v4"
  },
  "build": {
    "tasks": [
      { "for": "nodejs" },
      { "for": "postgres" }
    ]
  }
}
