{
  "name": "dispatcher-app",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/postgres": "^3",
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "patch-package": "^8.0.1"
  },
  "devDependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "ui": "cd app/dispatcher && npm run dev",
    "build:ui": "cd app/dispatcher && npm run build",
    "postinstall": "patch-package"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "db": "postgres"
      }
    }
  }
}
